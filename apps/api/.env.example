# InnerOS API Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Envelope Encryption Key (32-byte hex string)
INNEROS_MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET_KEY=inneros_dev_secret_jwt_key_synthetic_only_not_for_prod

# Providers
AI_PRIMARY_PROVIDER=synthetic
VOICE_STT_PROVIDER=synthetic
VOICE_TTS_PROVIDER=synthetic

# Safety
SAFETY_ENGINE_ENABLED=true
DEFAULT_REGION=US
