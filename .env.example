# InnerOS Root Environment Configuration
# NOTE: Uses synthetic mocks by default. No real API keys required for development or CI.

# Environment
NODE_ENV=development
ENVIRONMENT=development
PORT=3000
API_PORT=8000

# Backend FastAPI Configuration
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Security & Master Encryption Key (32-byte hex for envelope encryption)
# Generated mock key for local synthetic development
INNEROS_MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET_KEY=inneros_dev_secret_jwt_key_synthetic_only_not_for_prod

# Modular AI Providers (Set to 'synthetic' by default)
AI_PRIMARY_PROVIDER=synthetic
# AI_PRIMARY_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
# GEMINI_API_KEY=your_key_here

# Replaceable Voice Providers (Set to 'synthetic' by default)
VOICE_STT_PROVIDER=synthetic
VOICE_TTS_PROVIDER=synthetic
# ELEVENLABS_API_KEY=your_key_here
# DEEPGRAM_API_KEY=your_key_here

# Database Configuration (PostgreSQL 16 + pgvector)
# For local skeleton development, SQLite fallback or local Postgres may be used
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inneros_dev

# Non-Clinical Safety & Emergency Escalation
SAFETY_ENGINE_ENABLED=true
EMERGENCY_HELPLINE_DEFAULT=988
